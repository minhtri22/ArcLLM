    },
    "F1_BOUNDARY_EXISTENCE": {
      "per_fixture_signature": "material_excess(T32_GPU_PACKED,S32)",
      "partition_pass_all_required": [
        "at least 2 of 5 strata group-pass within K4096_R64",
        "at least 2 of 5 strata group-pass within K16384_R64",
        "the two shapes share at least one group-passing stress stratum"
      ],
      "if_fail_identification": "BOUNDARY_NOT_REPRODUCED",
      "if_fail_confirmatory": "BOUNDARY_NOT_REPRODUCED"
    },
    "F2_H_RTCI": {
      "cpu_topology_signature": "material_excess(T32_CPU,S32)",
      "expanded_gpu_persistence_signature": "material_excess(T32_GPU_EXPANDED,S32)",
      "required_groups": [
        "HIGH_CANCELLATION group-pass for both signatures in both shapes",
        "SCALE_HETEROGENEITY group-pass for both signatures in both shapes"
      ],
      "interaction_test": "for each shape independently, median R_TOPOLOGY_CPU over HIGH_CANCELLATION + SCALE_HETEROGENEITY replicates divided by max(median R_TOPOLOGY_CPU over LOW_CANCELLATION_BOUNDED_RANGE + NEUTRAL_RANDOM_CONTROL replicates,1.0) >= 1.5",
      "candidate_if_all_required": true
    },
    "F3_H_PDI": {
      "semantic_invariant_required": "all fixtures used for the candidate have q_mismatches=0, scale_mismatches=0, d_mismatches=0",
      "per_fixture_signature": "material_excess(T32_GPU_PACKED,T32_GPU_EXPANDED)",
      "partition_candidate_all_required": [
        "at least 2 of 5 strata group-pass within each shape",
        "the two shapes share at least one group-passing stress stratum"
      ]
    },
    "F4_H_DSA": {
      "per_fixture_signature": "material_excess(T32_GPU_EXPANDED,T32_CPU)",
      "partition_candidate_all_required": [
        "at least 2 of 5 strata group-pass within each shape",
        "the two shapes share at least one group-passing stress stratum"
      ]
    },
    "F5_H_SEM": {
      "mismatch_classes": [
        "q_mismatches",
        "scale_mismatches",
        "d_mismatches"
      ],
      "group_signature_pass": "the same mismatch class is nonzero in at least 2 of 3 replicates",
      "partition_candidate_all_required": [
        "at least one stratum has a semantic mismatch group-pass in K4096_R64",
        "the same mismatch class and at least one same stratum group-pass in K16384_R64"
      ]
    },
    "F6_MULTIFACTOR_OR_UNRESOLVED": {
      "multiple_candidates_same_partition": "retain all candidates; do not select a winner",
      "boundary_exists_no_candidate_identification": "UNRESOLVED_MECHANISM",
      "boundary_exists_no_confirmed_identification_candidate": "UNRESOLVED_MECHANISM"
