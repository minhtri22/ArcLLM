    "F0_INVALID_EXECUTION_OR_PROVENANCE": {
      "evaluated_first": true,
      "invalid_if_any": [
        "locked source/blob/SPIR-V/executable identity mismatch",
        "seed/fixture schedule mismatch",
        "wrong fixture count/order/partition",
        "target device or hard environment mismatch",
        "required subgroup size/basic/arithmetic support mismatch",
        "missing/corrupt/unparseable evidence",
        "selective rerun or post-outcome fixture substitution",
        "execution without the future explicit stage authorization"
