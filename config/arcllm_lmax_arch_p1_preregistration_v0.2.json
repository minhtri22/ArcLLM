    "arm_definitions": {
      "A": {
        "id": "DIRECT_LOCKED_SPSC64",
        "role": "zero-model control-path comparator only",
        "producer_count": 1,
        "consumer_count": 1,
        "capacity": 64,
        "storage": "fixed preallocated array of 64 event slots",
        "synchronization": {
          "state": "head_tail_count protected by exactly one std::mutex",
          "producer_block": "std::condition_variable not_full",
          "consumer_block": "std::condition_variable not_empty",
          "wait_predicates": {
            "producer": "count < 64",
            "consumer": "count > 0"
          },
          "producer_notify": "notify_one(not_empty) after publication",
          "consumer_notify": "notify_one(not_full) after removal"
        },
        "allocation_policy": {
          "dynamic_allocation_after_queue_initialization": false,
          "event_payload_preallocated": true
        },
        "ordering": "FIFO",
        "spin_count_definition": "always 0",
        "switch_to_thread_count_definition": "always 0",
        "wait_on_address_count_definition": "always 0",
        "condition_variable_wait_count": "serialized separately for producer and consumer",
        "wake_count_definition": "number of notify_one calls"
      },
      "B": {
        "id": "LMAX_RING_P1",
        "role": "zero-model sequenced-ring arm",
        "producer_count": 1,
        "consumer_count": 1,
        "capacity": 64,
        "storage": "fixed preallocated sequenced slots",
        "wait_policy": {
          "active_yieldprocessor_spins": 16,
          "switch_to_thread_calls_before_block": 1,
          "blocking_primitive": "WaitOnAddress",
          "wake_primitive": "WakeByAddressSingle",
          "sleep_allowed": false,
          "timed_polling_allowed": false
        },
        "allocation_policy": {
          "dynamic_allocation_after_ring_initialization": false,
          "event_payload_preallocated": true
        },
        "ordering": "sequence-number FIFO"
      }
    },
    "common_event_and_timestamp_semantics": {
      "event_payload": "fixed-size event containing uint64 sequence_id and uint64 publish_timestamp_ns; no owning heap pointer/string/container",
      "publish_timestamp_ns": "captured immediately before the event is made visible to the consumer: before count increment for Arm A and before release sequence publication for Arm B",
      "consume_timestamp_ns": "captured immediately after successful dequeue/slot consume and payload copy, before producer-unblocking notification/wake",
      "publish_to_consume_latency_ns": "consume_timestamp_ns - publish_timestamp_ns",
      "monotonic_clock": "same high-resolution monotonic clock implementation for both arms",
      "consumer_service_delay_position": "applied after consume_timestamp_ns is captured and before the consumer attempts the next event",
      "event_order_reference": "expected sequence_id is exactly 0..999999"
    },
    "backpressure_semantics": {
      "observation_definition": "increment at most once per event when the producer first observes no free capacity before blocking",
      "arm_A_full_condition": "count == 64",
      "arm_B_full_condition": "target sequenced slot is not available for the producer sequence",
      "observation_rate_formula": "full_backpressure_observations / 1000000",
      "not_worse_rule": "For each qualifying delay cell, Arm B observation_rate <= Arm A observation_rate.",
      "repeated_wakeups_for_same_event": "do not increment the observation again"
    },
    "comparator_fairness_invariants": [
      "same producer_count=1 and consumer_count=1",
      "same capacity=64",
      "same fixed event payload",
      "same 1,000,000 events per arm per delay",
      "same service-delay position",
      "same publish/consume timestamp positions",
      "no dynamic allocation after queue/ring initialization",
      "same monotonic clock",
      "same raw artifact formats and exact lengths"
    ],
