  "required_consistency_equations": [
    "runner.lock.path == lock.path",
    "success_result.lock.path == lock.path",
    "failure_result.lock.path == lock.path",
    "success_result.lock.blob == git_blob(lock.path)",
    "failure_result.lock.blob == git_blob(lock.path)",
    "evidence_manifest.lock.source_path == lock.path",
    "package_manifest.lock.source_path == lock.path",
    "package_manifest.lock.destination_name == canonical_lock_destination_name",
    "runner.result_schema == success_result_schema.$id",
    "runner.failure_schema == failure_result_schema.$id",
    "evidence_manifest.schema_version == runner.expected_evidence_manifest_schema_version",
    "package_manifest.schema_version == runner.expected_package_manifest_schema_version",
    "adjudicator_input.package_manifest_hash == produced_package_manifest_hash",
    "every_bundle_member appears exactly once in package_manifest",
    "every_required_bundle_member has exactly one source_to_destination mapping",
    "every reported git blob resolves from the frozen HEAD",
    "no stale version token appears in runner, lock, schemas, manifests or destination labels"
  ],
  "authority_operationalization_rule": {
    "description": "A gate must compare against its intended frozen authority, not a duplicate of its own candidate source.",
    "same_source_tautology_fixture_must_fail": true
  },
  "required_negative_fixtures": [
    "STALE_LOCK_VERSION",
    "WRONG_BUNDLE_DESTINATION_FILENAME",
    "WRONG_GIT_BLOB_FIELD",
    "MISSING_EVIDENCE_MEMBER",
