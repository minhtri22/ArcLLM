#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer WBuf { uint w[]; } W;
layout(std430, binding = 1) readonly buffer IdBuf { uint ids[]; } I;
layout(std430, binding = 2) writeonly buffer YBuf { float y[]; } Y;
layout(push_constant) uniform PC { uint n; uint batch; uint row_bytes; uint w_base_bytes; } pc;
uint load_u8(uint byte_off){uint word=W.w[byte_off>>2u];uint shift=(byte_off&3u)*8u;return(word>>shift)&255u;}
uint load_u16(uint byte_off){return load_u8(byte_off)|(load_u8(byte_off+1u)<<8u);}
float fp16_at(uint byte_off){return unpackHalf2x16(load_u16(byte_off)).x;}
int load_i8(uint byte_off){int v=int(load_u8(byte_off));return(v>=128)?(v-256):v;}
int q6_value(uint base,uint k,out int scale){uint half128=k>>7u;uint kk=k&127u;uint l=kk&31u;uint quarter=kk>>5u;uint ql_base=base+half128*64u;uint qh_base=base+128u+half128*32u;uint sc_base=base+192u+half128*8u;uint is=l>>4u;uint low;uint high;uint sc_idx;if(quarter==0u){low=load_u8(ql_base+l)&15u;high=(load_u8(qh_base+l)>>0u)&3u;sc_idx=is+0u;}else if(quarter==1u){low=load_u8(ql_base+l+32u)&15u;high=(load_u8(qh_base+l)>>2u)&3u;sc_idx=is+2u;}else if(quarter==2u){low=load_u8(ql_base+l)>>4u;high=(load_u8(qh_base+l)>>4u)&3u;sc_idx=is+4u;}else{low=load_u8(ql_base+l+32u)>>4u;high=(load_u8(qh_base+l)>>6u)&3u;sc_idx=is+6u;}scale=load_i8(sc_base+sc_idx);return int(low|(high<<4u))-32;}
void main(){uint idx=gl_GlobalInvocationID.x;uint total=pc.n*pc.batch;if(idx>=total)return;uint token=idx/pc.n;uint k=idx-token*pc.n;uint row=I.ids[token];uint ib=k>>8u;uint within=k&255u;uint base=pc.w_base_bytes+row*pc.row_bytes+ib*210u;float d=fp16_at(base+208u);int sc;int q=q6_value(base,within,sc);Y.y[idx]=d*float(sc)*float(q);}
