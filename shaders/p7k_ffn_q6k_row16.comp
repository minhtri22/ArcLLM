#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) readonly buffer WBuf { uint w[]; } W;
layout(std430, binding = 1) readonly buffer XBuf { float x[]; } X;
layout(std430, binding = 2) readonly buffer BiasBuf { float bias[]; } B;
layout(std430, binding = 3) writeonly buffer YBuf { float y[]; } Y;
layout(push_constant) uniform PC { uint n; uint rows; uint batch; uint row_bytes; uint add_bias; uint w_base_bytes; uint bias_base; } pc;
shared float sW[512];
shared float sX[512];
uint load_u8(uint byte_off){uint word=W.w[byte_off>>2u];uint shift=(byte_off&3u)*8u;return(word>>shift)&255u;}
uint load_u16(uint byte_off){return load_u8(byte_off)|(load_u8(byte_off+1u)<<8u);}
float fp16_at(uint byte_off){return unpackHalf2x16(load_u16(byte_off)).x;}
int load_i8(uint byte_off){int v=int(load_u8(byte_off));return(v>=128)?(v-256):v;}
int q6_value(uint base,uint kin,out int scale){uint half128=kin>>7u;uint kk=kin&127u;uint l=kk&31u;uint quarter=kk>>5u;uint ql_base=base+half128*64u;uint qh_base=base+128u+half128*32u;uint sc_base=base+192u+half128*8u;uint is=l>>4u;uint low;uint high;uint sc_idx;if(quarter==0u){low=load_u8(ql_base+l)&15u;high=(load_u8(qh_base+l)>>0u)&3u;sc_idx=is+0u;}else if(quarter==1u){low=load_u8(ql_base+l+32u)&15u;high=(load_u8(qh_base+l)>>2u)&3u;sc_idx=is+2u;}else if(quarter==2u){low=load_u8(ql_base+l)>>4u;high=(load_u8(qh_base+l)>>4u)&3u;sc_idx=is+4u;}else{low=load_u8(ql_base+l+32u)>>4u;high=(load_u8(qh_base+l)>>6u)&3u;sc_idx=is+6u;}scale=load_i8(sc_base+sc_idx);return int(low|(high<<4u))-32;}
float dequant_w(uint row,uint k){uint ib=k>>8u;uint kin=k&255u;uint base=pc.w_base_bytes+row*pc.row_bytes+ib*210u;float d=fp16_at(base+208u);int sc;int q=q6_value(base,kin,sc);return d*float(sc)*float(q);}
void main(){
 uint lr=gl_LocalInvocationID.x,lt=gl_LocalInvocationID.y,lid=gl_LocalInvocationIndex;
 uint row0=gl_WorkGroupID.x*16u, tok0=gl_WorkGroupID.y*16u;
 uint row_a=row0+lr, row_b=row0+lr+8u, tok_a=tok0+lt, tok_b=tok0+lt+8u;
 bool valid_aa=(row_a<pc.rows && tok_a<pc.batch);
 bool valid_ab=(row_a<pc.rows && tok_b<pc.batch);
 bool valid_ba=(row_b<pc.rows && tok_a<pc.batch);
 bool valid_bb=(row_b<pc.rows && tok_b<pc.batch);
 float bias_a=(row_a<pc.rows && pc.add_bias!=0u)?B.bias[pc.bias_base+row_a]:0.0;
 float bias_b=(row_b<pc.rows && pc.add_bias!=0u)?B.bias[pc.bias_base+row_b]:0.0;
 float acc_aa=valid_aa?bias_a:0.0, acc_ab=valid_ab?bias_a:0.0;
 float acc_ba=valid_ba?bias_b:0.0, acc_bb=valid_bb?bias_b:0.0;
 for(uint k0=0u;k0<pc.n;k0+=32u){
   for(uint idx=lid;idx<512u;idx+=64u){uint rr=idx>>5u,kk=idx&31u,gr=row0+rr;sW[idx]=(gr<pc.rows)?dequant_w(gr,k0+kk):0.0;}
   for(uint idx=lid;idx<512u;idx+=64u){uint tt=idx>>5u,kk=idx&31u,gt=tok0+tt;sX[idx]=(gt<pc.batch)?X.x[gt*pc.n+k0+kk]:0.0;}
   barrier();
   uint wa=lr*32u, wb=(lr+8u)*32u, xa=lt*32u, xb=(lt+8u)*32u;
   if(valid_aa){for(uint kk=0u;kk<32u;++kk)acc_aa+=sW[wa+kk]*sX[xa+kk];}
   if(valid_ab){for(uint kk=0u;kk<32u;++kk)acc_ab+=sW[wa+kk]*sX[xb+kk];}
   if(valid_ba){for(uint kk=0u;kk<32u;++kk)acc_ba+=sW[wb+kk]*sX[xa+kk];}
   if(valid_bb){for(uint kk=0u;kk<32u;++kk)acc_bb+=sW[wb+kk]*sX[xb+kk];}
   barrier();
 }
 if(valid_aa)Y.y[tok_a*pc.rows+row_a]=acc_aa;
 if(valid_ab)Y.y[tok_b*pc.rows+row_a]=acc_ab;
 if(valid_ba)Y.y[tok_a*pc.rows+row_b]=acc_ba;
 if(valid_bb)Y.y[tok_b*pc.rows+row_b]=acc_bb;
}
