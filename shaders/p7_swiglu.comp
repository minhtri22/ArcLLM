#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer GateBuf { float gate[]; } G;
layout(std430, binding = 1) readonly buffer UpBuf { float up[]; } U;
layout(std430, binding = 2) writeonly buffer YBuf { float y[]; } Y;
layout(push_constant) uniform PC { uint n; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float g = G.gate[i];
    Y.y[i] = (g / (1.0 + exp(-g))) * U.up[i];
}
