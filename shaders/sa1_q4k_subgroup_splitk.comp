#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer WBuf { uint w[]; } W;
layout(std430, binding = 1) readonly buffer XBuf { float x[]; } X;
layout(std430, binding = 2) readonly buffer BiasBuf { float bias[]; } B;
layout(std430, binding = 3) writeonly buffer YBuf { float y[]; } Y;

layout(push_constant) uniform PC {
    uint n;
    uint rows;
    uint batch;
    uint row_bytes;
    uint add_bias;
    uint w_base_bytes;
    uint bias_base;
} pc;

uint load_u8(uint byte_off) {
    uint word = W.w[byte_off >> 2u];
    uint shift = (byte_off & 3u) * 8u;
    return (word >> shift) & 255u;
}

uint load_u16(uint byte_off) {
    return load_u8(byte_off) | (load_u8(byte_off + 1u) << 8u);
}

float fp16_at(uint byte_off) {
    return unpackHalf2x16(load_u16(byte_off)).x;
}

void scale_min(uint base, uint j, out uint sc, out uint mn) {
    uint qj;
    if (j < 4u) {
        sc = load_u8(base + 4u + j) & 63u;
        mn = load_u8(base + 8u + j) & 63u;
    } else {
        qj = load_u8(base + 4u + j + 4u);
        sc = (qj & 15u) | ((load_u8(base + 4u + j - 4u) >> 6u) << 4u);
        mn = (qj >> 4u) | ((load_u8(base + 4u + j) >> 6u) << 4u);
    }
}

float dequant_q4(uint row_base, uint k) {
    uint ib = k >> 8u;
    uint kin = k & 255u;
    uint base = row_base + ib * 144u;
    float d = fp16_at(base);
    float dmin = fp16_at(base + 2u);
    uint sc;
    uint mn;
    scale_min(base, kin >> 5u, sc, mn);
    uint local64 = kin & 63u;
    uint qbyte = load_u8(base + 16u + (kin >> 6u) * 32u + (local64 & 31u));
    uint q = (local64 < 32u) ? (qbyte & 15u) : (qbyte >> 4u);
    return d * float(sc) * float(q) - dmin * float(mn);
}

void main() {
    uint subgroup = gl_SubgroupID;
    uint lane = gl_SubgroupInvocationID;
    uint row = gl_WorkGroupID.x * 4u + subgroup;
    if (row >= pc.rows) return;

    uint row_base = pc.w_base_bytes + row * pc.row_bytes;
    float partial = 0.0;
    for (uint k = lane; k < pc.n; k += 32u) {
        partial += dequant_q4(row_base, k) * X.x[k];
    }

    float sum = subgroupAdd(partial);
    if (lane == 0u) {
        if (pc.add_bias != 0u) sum += B.bias[pc.bias_base + row];
        Y.y[row] = sum;
    }
}
