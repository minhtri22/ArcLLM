#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(std430,binding=0) readonly buffer WBuf{uint w[];}W;layout(std430,binding=1) readonly buffer XBuf{float x[];}X;layout(std430,binding=2) readonly buffer BiasBuf{float bias[];}B;layout(std430,binding=3) writeonly buffer YBuf{float y[];}Y;
layout(push_constant) uniform PC{uint n;uint rows;uint batch;uint row_bytes;uint add_bias;uint w_base_bytes;uint bias_base;}pc;
uint u8(uint o){uint v=W.w[o>>2u];return(v>>((o&3u)*8u))&255u;}uint u16(uint o){return u8(o)|(u8(o+1u)<<8u);}float f16(uint o){return unpackHalf2x16(u16(o)).x;}
float dq(uint rb,uint k){uint ib=k>>8u,kin=k&255u,base=rb+ib*148u;float d=f16(base),dm=f16(base+2u);uint j=kin>>5u,sc=u8(base+4u+2u*j),mn=u8(base+5u+2u*j),qb=u8(base+20u+(kin>>1u)),q=(kin&1u)!=0u?(qb>>4u):(qb&15u);return d*float(sc)*float(q)-dm*float(mn);}
void main(){uint sg=gl_SubgroupID,lane=gl_SubgroupInvocationID,row=gl_WorkGroupID.x*4u+sg;if(row>=pc.rows)return;uint rb=pc.w_base_bytes+row*pc.row_bytes;float partial=0.0;for(uint k=lane;k<pc.n;k+=32u)partial+=dq(rb,k)*X.x[k];float sum=subgroupAdd(partial);if(lane==0u){if(pc.add_bias!=0u)sum+=B.bias[pc.bias_base+row];Y.y[row]=sum;}}
