#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) readonly buffer WBuf { uint w[]; } W;
layout(std430, binding = 1) readonly buffer XBuf { float x[]; } X;
layout(std430, binding = 2) readonly buffer BiasBuf { float bias[]; } B;
layout(std430, binding = 3) writeonly buffer YBuf { float y[]; } Y;
layout(push_constant) uniform PC { uint n; uint rows; uint batch; uint row_bytes; uint add_bias; uint w_base_bytes; uint bias_base; } pc;
shared float sW[256];
shared float sX[512];
uint load_u8(uint byte_off){uint word=W.w[byte_off>>2u];uint shift=(byte_off&3u)*8u;return(word>>shift)&255u;}
uint load_u16(uint byte_off){return load_u8(byte_off)|(load_u8(byte_off+1u)<<8u);}
float fp16_at(uint byte_off){return unpackHalf2x16(load_u16(byte_off)).x;}
int load_i8(uint byte_off){int v=int(load_u8(byte_off));return(v>=128)?(v-256):v;}
uint load_u32_unaligned(uint byte_off){uint wi=byte_off>>2u;uint sh=(byte_off&3u)*8u;uint lo=W.w[wi]>>sh;if(sh==0u)return lo;return lo|(W.w[wi+1u]<<(32u-sh));}
void main(){
 uint lr=gl_LocalInvocationID.x,lt=gl_LocalInvocationID.y,lid=gl_LocalInvocationIndex;
 uint row0=gl_WorkGroupID.x*8u, tok0=gl_WorkGroupID.y*16u;
 uint row=row0+lr, tok_a=tok0+lt, tok_b=tok0+lt+8u;
 bool valid_a=(row<pc.rows && tok_a<pc.batch);
 bool valid_b=(row<pc.rows && tok_b<pc.batch);
 float biasv=(row<pc.rows && pc.add_bias!=0u)?B.bias[pc.bias_base+row]:0.0;
 float acc_a=valid_a?biasv:0.0, acc_b=valid_b?biasv:0.0;
 for(uint k0=0u;k0<pc.n;k0+=32u){
   uint kk0=lt*4u;
   if(row<pc.rows){
     uint ib=k0>>8u, kin0=k0&255u;
     uint base=pc.w_base_bytes+row*pc.row_bytes+ib*210u;
     float d=fp16_at(base+208u);
     uint half128=kin0>>7u, quarter=(kin0&127u)>>5u;
     uint ql_base=base+half128*64u, qh_base=base+128u+half128*32u, sc_base=base+192u+half128*8u;
     uint is=kk0>>4u, sc_idx;
     if(quarter==0u)sc_idx=is+0u;else if(quarter==1u)sc_idx=is+2u;else if(quarter==2u)sc_idx=is+4u;else sc_idx=is+6u;
     int sc=load_i8(sc_base+sc_idx);
     uint ql_off=ql_base+((quarter==1u||quarter==3u)?32u:0u)+kk0;
     uint qh_off=qh_base+kk0;
     uint qlw=load_u32_unaligned(ql_off), qhw=load_u32_unaligned(qh_off), hshift=quarter*2u;
     bool ql_high=(quarter>=2u);
     for(uint j=0u;j<4u;++j){uint qlb=(qlw>>(j*8u))&255u;uint qhb=(qhw>>(j*8u))&255u;uint low=ql_high?(qlb>>4u):(qlb&15u);uint high=(qhb>>hshift)&3u;int q=int(low|(high<<4u))-32;sW[lr*32u+kk0+j]=d*float(sc)*float(q);}
   }else{for(uint j=0u;j<4u;++j)sW[lr*32u+kk0+j]=0.0;}
   for(uint idx=lid;idx<512u;idx+=64u){uint tt=idx>>5u,kk=idx&31u,gt=tok0+tt;sX[idx]=(gt<pc.batch)?X.x[gt*pc.n+k0+kk]:0.0;}
   barrier();
   uint wb=lr*32u,xa=lt*32u,xb=(lt+8u)*32u;
   if(valid_a){for(uint kk=0u;kk<32u;++kk)acc_a+=sW[wb+kk]*sX[xa+kk];}
   if(valid_b){for(uint kk=0u;kk<32u;++kk)acc_b+=sW[wb+kk]*sX[xb+kk];}
   barrier();
 }
 if(valid_a)Y.y[tok_a*pc.rows+row]=acc_a;
 if(valid_b)Y.y[tok_b*pc.rows+row]=acc_b;
}
