{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arcllm.ttft_m2.package_manifest.v0.1",
  "title": "TTFT_M2 atomic package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package_id",
    "package_version",
    "canonical_lock",
    "runner",
    "schema_bindings",
    "members",
    "output_bundle_name",
    "p7_authorization_slot",
    "adjudicator_sidecar"
  ],
  "properties": {
    "schema": {
      "const": "arcllm.ttft_m2.package_manifest.v0.1"
    },
    "package_id": {
      "const": "ARCLLM_TTFT_M2_ATOMIC_PACKAGE"
    },
    "package_version": {
      "const": "v0.1"
    },
    "canonical_lock": {
      "$ref": "#/$defs/staticBinding"
    },
    "runner": {
      "$ref": "#/$defs/staticBinding"
    },
    "schema_bindings": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {
        "$ref": "#/$defs/staticBinding"
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/member"
      }
    },
    "output_bundle_name": {
      "const": "results/ttft_m2_buildonly_return_to_chatgpt.zip"
    },
    "p7_authorization_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "schema_id",
        "decision",
        "binding_mode"
      ],
      "properties": {
        "source_path": {
          "const": "config/arcllm_ttft_m2_p7_buildonly_authorization_v0.1.json"
        },
        "schema_id": {
          "const": "arcllm.ttft_m2.p7.buildonly_authorization.v0.1"
        },
        "decision": {
          "const": "M2_P7_BUILDONLY_AUTHORIZED"
        },
        "binding_mode": {
          "const": "RUNTIME_REQUIRED_EXACT_GIT_BLOB"
        }
      }
    },
    "adjudicator_sidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destination_name",
        "schema_id",
        "binding_mode",
        "included_in_bundle"
      ],
      "properties": {
        "destination_name": {
          "const": "TTFT_M2_ADJUDICATOR_INPUT.json"
        },
        "schema_id": {
          "const": "arcllm.ttft_m2.adjudicator_input.v0.1"
        },
        "binding_mode": {
          "const": "RUNTIME_GENERATED_AFTER_BUNDLE_HASH"
        },
        "included_in_bundle": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "staticBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "git_blob"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "git_blob": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "binding_mode",
        "destination_name",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "binding_mode": {
          "enum": [
            "STATIC_COMMITTED",
            "RUNTIME_REQUIRED_EXACT_GIT_BLOB",
            "RUNTIME_GENERATED"
          ]
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "destination_name": {
          "type": "string",
          "minLength": 1
        },
        "git_blob": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "schema_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    }
  }
}
