{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arcllm.ttft_m2.evidence_manifest.v0.1",
  "title": "TTFT_M2 evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package_id",
    "package_version",
    "lock",
    "runner",
    "members",
    "zero_science"
  ],
  "properties": {
    "schema": {
      "const": "arcllm.ttft_m2.evidence_manifest.v0.1"
    },
    "package_id": {
      "const": "ARCLLM_TTFT_M2_ATOMIC_PACKAGE"
    },
    "package_version": {
      "const": "v0.1"
    },
    "lock": {
      "$ref": "#/$defs/staticBinding"
    },
    "runner": {
      "$ref": "#/$defs/staticBinding"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/member"
      }
    },
    "zero_science": {
      "type": "object",
      "required": [
        "target_model_load_permitted",
        "gpu_dispatch_permitted",
        "performance_measurement_permitted"
      ],
      "properties": {
        "target_model_load_permitted": {
          "const": false
        },
        "gpu_dispatch_permitted": {
          "const": false
        },
        "performance_measurement_permitted": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "staticBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "destination_name",
        "git_blob"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "destination_name": {
          "type": "string",
          "minLength": 1
        },
        "git_blob": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "binding_mode",
        "destination_name",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "binding_mode": {
          "enum": [
            "STATIC_COMMITTED",
            "RUNTIME_REQUIRED_EXACT_GIT_BLOB",
            "RUNTIME_GENERATED"
          ]
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "destination_name": {
          "type": "string",
          "minLength": 1
        },
        "git_blob": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "schema_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    }
  }
}
